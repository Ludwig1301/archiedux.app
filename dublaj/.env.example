# Dub Pack stüdyosu ayarları. Bu dosyayı dublaj/.env olarak kopyala.
# Next.js bu dosyayı dublaj servisi başlarken kendisi okur; servis ister ana sunucu
# tarafından, ister pm2 ile ayrı başlatılsın aynı şekilde çalışır.
# Ayrıntılar: README.md → "7) Dub Pack stüdyosu".

# Paket dosyalarının (video, ses katmanları, pack.json) diskteki yeri — kalıcı olmalı.
# Göreli yol dublaj/ klasörüne göredir.
# PACKS_DIR=storage/packs

# Türkçe metne çevirme (Whisper API). Anahtar yoksa yerel `whisper`, o da yoksa sadece zaman damgası çıkar.
OPENAI_API_KEY=
# TRANSCRIBER_ORDER=openai,local,silence
# WHISPER_MODEL=small

# Vokal / arka plan ayrıştırma. Sırayla denenir: yerel Demucs → Replicate → FFmpeg (düşük kalite yedek).
# 1 GB RAM'li sunucularda Demucs çalışmaz; Replicate kullan.
REPLICATE_API_TOKEN=
# STEM_SEPARATOR_ORDER=demucs,replicate,ffmpeg
# DEMUCS_MODEL=htdemucs

# YouTube sunucuda "Sign in to confirm you're not a bot" derse tarayıcıdan dışa aktarılan cookies.txt yolu
# YTDLP_COOKIES=/home/ubuntu/secrets/youtube-cookies.txt

# Araç yolları PATH'te değilse
# FFMPEG_PATH=/usr/local/bin/ffmpeg
# FFPROBE_PATH=/usr/local/bin/ffprobe
# YTDLP_PATH=/usr/local/bin/yt-dlp
# PYTHON_PATH=python3

# Limitler (yükleme limiti Nginx'teki client_max_body_size'dan küçük olmalı)
# MAX_CONCURRENT_JOBS=1
# MAX_UPLOAD_MB=140

# Yönetici anahtarı: tüm paketleri düzenler/yayınlar (paketler sayfasında anahtar simgesinden girilir).
DUBPACK_ADMIN_TOKEN=
# true → kütüphaneye sadece yönetici yayınlayabilir (kullanıcılar taslakla dublaj yapmaya devam eder)
# DUBPACK_PUBLISH_REQUIRES_ADMIN=false
