# Discord Developer Portal (https://discord.com/developers/applications) -> Uygulamanı aç
DISCORD_CLIENT_ID=Buraya-UygulamaID-si-yaz
DISCORD_CLIENT_SECRET=Buraya-ClientSecret-yaz

# OAuth2 -> Redirects kısmına EKSİKSİZ bu adresi ekle (sonunda /auth/callback ile)
# Localde test için: http://localhost:3000/auth/callback
# Canlıda: https://archiedux.com/auth/callback
DISCORD_REDIRECT_URI=http://localhost:3000/auth/callback

# Bot -> Uygulamana bir Bot ekle, tokenini buraya yapıştır.
# Botu sunucuna davet etmen gerekiyor (aşağıda README'de anlatıldı).
DISCORD_BOT_TOKEN=Buraya-BotToken-yaz

# Sunucunun (guild) ID'si - Discord'da sunucu ismine sağ tık -> Sunucu Kimliğini Kopyala
DISCORD_GUILD_ID=Buraya-SunucuID-si-yaz

# Oturum şifrelemesi için rastgele, uzun bir metin (kimseyle paylaşma)
SESSION_SECRET=bunu-rastgele-uzun-bir-metinle-degistir

# Film & Dizi Günlüğü için TMDB API anahtarı (ücretsiz)
# https://www.themoviedb.org/settings/api adresinden "API Key" al.
# Boş bırakılırsa arama yapılamaz ama site kırılmaz.
TMDB_API_KEY=Buraya-TMDB-API-Key-yaz

# Kitap Günlüğü için isteğe bağlı Google Books API anahtarı (ücretsiz)
# https://developers.google.com/books/docs/v1/using adresinden alınabilir.
# Boş bırakılırsa arama yine çalışır ama yoğun kullanımda kota sınırına takılabilir.
GOOGLE_BOOKS_API_KEY=Buraya-Google-Books-API-Key-yaz

PORT=3000
